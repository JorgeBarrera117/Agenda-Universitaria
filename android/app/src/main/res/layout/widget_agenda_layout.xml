<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Fila Superior: Título de la App, Subtítulo y Botón de Apertura -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/widget_header_clickable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_name"
                android:textColor="#ffffff"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoy"
                android:textColor="#94a3b8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Botón con icono vectorial de la app para abrir -->
        <FrameLayout
            android:id="@+id/widget_btn_open_app"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_add_btn_bg">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Abrir Agenda"
                android:src="@drawable/ic_widget_external_link" />
        </FrameLayout>
    </LinearLayout>

    <!-- Fila de Pestañas con Iconos Vectoriales Nativos de la App (Sin Emojis) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="8dp">

        <!-- Pestaña Horario -->
        <LinearLayout
            android:id="@+id/widget_btn_tab_schedule"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_active"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon_tab_schedule"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Icono Horario"
                android:src="@drawable/ic_widget_calendar" />

            <TextView
                android:id="@+id/widget_text_tab_schedule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_tab_schedule"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pestaña Apuntes -->
        <LinearLayout
            android:id="@+id/widget_btn_tab_notes"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tab_inactive"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_icon_tab_notes"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Icono Apuntes"
                android:src="@drawable/ic_widget_notes" />

            <TextView
                android:id="@+id/widget_text_tab_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_tab_notes"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Contenedor Principal de la Lista Deslizante -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_list_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="6dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/widget_empty_schedule"
            android:textColor="#64748b"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
