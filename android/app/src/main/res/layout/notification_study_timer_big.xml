<?xml version="1.0" encoding="utf-8"?>
<!--
  Modo estudio, notificación desplegada: la fase arriba, el tiempo que queda en grande (corre solo),
  el detalle (sesión y materia, o a qué hora se vuelve a estudiar) y la barra de avance del bloque.
  La fase va en su propia línea: junto al tiempo grande y al ícono redondo no cabía completa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/study_phase"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp" />

    <Chronometer
        android:id="@+id/study_chrono"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/study_detail"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2" />

    <ProgressBar
        android:id="@+id/study_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:max="100" />
</LinearLayout>
