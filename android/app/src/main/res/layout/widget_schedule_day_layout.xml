<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_day_root_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Capa de Fondo Dinámica Tintable según el Tema (Material You) -->
    <ImageView
        android:id="@+id/widget_day_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_bg"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_day_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Fila Superior: Título con Día Seleccionado y Acciones Rápidas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/widget_day_header_clickable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_day_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Horario • Jueves"
                    android:textColor="#ffffff"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_day_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca un día para consultar"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Botón para volver a HOY rápidamente -->
            <FrameLayout
                android:id="@+id/widget_day_btn_today"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/widget_day_btn_today_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_day_btn_today_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/widget_btn_today"
                    android:textColor="#ffffff"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Botón para abrir la app -->
            <FrameLayout
                android:id="@+id/widget_day_btn_open_app"
                android:layout_width="26dp"
                android:layout_height="26dp">

                <ImageView
                    android:id="@+id/widget_day_btn_open_app_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_add_btn_bg"
                    android:scaleType="fitXY" />

                <ImageView
                    android:id="@+id/widget_day_icon_open_app"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="Abrir Agenda"
                    android:src="@drawable/ic_widget_external_link" />
            </FrameLayout>
        </LinearLayout>

        <!-- Barra de Selección de Día de la Semana (Lun, Mar, Mié, Jue, Vie, Sáb, Dom) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="8dp">

            <!-- Lunes (1) -->
            <FrameLayout
                android:id="@+id/widget_btn_day_1"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_day_1_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_btn_day_1_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Lun"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Martes (2) -->
            <FrameLayout
                android:id="@+id/widget_btn_day_2"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_day_2_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_btn_day_2_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Mar"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Miércoles (3) -->
            <FrameLayout
                android:id="@+id/widget_btn_day_3"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_day_3_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_btn_day_3_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Mié"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Jueves (4) -->
            <FrameLayout
                android:id="@+id/widget_btn_day_4"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_day_4_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_btn_day_4_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Jue"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Viernes (5) -->
            <FrameLayout
                android:id="@+id/widget_btn_day_5"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_day_5_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_btn_day_5_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Vie"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Sábado (6) -->
            <FrameLayout
                android:id="@+id/widget_btn_day_6"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_day_6_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_btn_day_6_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Sáb"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Domingo (7) -->
            <FrameLayout
                android:id="@+id/widget_btn_day_7"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/widget_btn_day_7_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/widget_tab_active"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_btn_day_7_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Dom"
                    android:textColor="#94a3b8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Contenedor Principal de la Lista de Clases del Día -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/widget_day_list_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="6dp"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/widget_day_empty_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/widget_day_empty"
                android:textColor="#64748b"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
