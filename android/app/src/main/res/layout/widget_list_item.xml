<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Fondo de Tarjeta con Esquinas Redondeadas Dinámico (Material You) -->
    <ImageView
        android:id="@+id/widget_item_bg_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_item_bg"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Indicador de color lateral de la Asignatura -->
        <ImageView
            android:id="@+id/widget_item_color_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="#38bdf8"
            android:contentDescription="Color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Fila Superior: Badge (HOY/DÍA) + Título + Hora/Fecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_item_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_badge_today_light"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="HOY"
                    android:textColor="#ffffff"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Título del elemento"
                    android:textColor="#ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_time_or_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="08:00 - 10:00"
                    android:textColor="#38bdf8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila Inferior: Detalles de Aula y Profesor / Subtítulo -->
            <TextView
                android:id="@+id/widget_item_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aula 101 • Docente"
                android:textColor="#94a3b8"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
