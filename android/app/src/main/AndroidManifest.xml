<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Android 11+: visibilidad de las apps que reciben archivos compartidos (WhatsApp, Gmail,
         Drive…) para concederles permiso de lectura del respaldo (WidgetBridgePlugin.shareJsonFile). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Apuntes compartidos (.agnote). WhatsApp y Drive entregan URI content:// SIN el
                 nombre del archivo, así que se filtra por tipo MIME: el propio de la app y, como
                 respaldo, los genéricos con los que algunas apps reetiquetan archivos desconocidos.
                 Lo que llega se valida en JS (el parser de cada formato) antes de
                 mostrar nada. Sirve igual para contactos (.agcontact), materias (.agclass) y
                 horarios completos (.agschedule). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.agenda-universitaria.note+json" />
                <data android:mimeType="application/vnd.agenda-universitaria.contact+json" />
                <data android:mimeType="application/vnd.agenda-universitaria.class+json" />
                <data android:mimeType="application/vnd.agenda-universitaria.schedule+json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Exploradores de archivos que abren por ruta (file:// o content:// con nombre) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.agnote" />
                <data android:pathPattern=".*\\..*\\.agnote" />
                <data android:pathPattern=".*\\..*\\..*\\.agnote" />
                <data android:pathPattern=".*\\.agcontact" />
                <data android:pathPattern=".*\\..*\\.agcontact" />
                <data android:pathPattern=".*\\..*\\..*\\.agcontact" />
                <data android:pathPattern=".*\\.agclass" />
                <data android:pathPattern=".*\\..*\\.agclass" />
                <data android:pathPattern=".*\\..*\\..*\\.agclass" />
                <data android:pathPattern=".*\\.agschedule" />
                <data android:pathPattern=".*\\..*\\.agschedule" />
                <data android:pathPattern=".*\\..*\\..*\\.agschedule" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Modo estudio: botones de la notificación en curso y alarma del fin de cada fase -->
        <receiver android:name=".StudyTimerReceiver" android:exported="false" />

        <!-- Receptor del Widget de la Pantalla de Inicio (3x3, 4x4) -->
        <receiver
            android:name=".AgendaWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.agenda.universitaria.ACTION_SWITCH_TAB" />
                <action android:name="com.agenda.universitaria.ACTION_ITEM_CLICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>

        <!-- Servicio de datos para la lista interactiva del Widget 1 -->
        <service
            android:name=".AgendaWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Receptor del Widget 2: Horario por Día de la Semana (3x3, 4x4) -->
        <receiver
            android:name=".ScheduleDayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_day_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.agenda.universitaria.ACTION_SELECT_DAY" />
                <action android:name="com.agenda.universitaria.ACTION_SELECT_TODAY" />
                <action android:name="com.agenda.universitaria.ACTION_DAY_ITEM_CLICK" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_day_widget_info" />
        </receiver>

        <!-- Servicio de datos para el Widget 2 de Horario por Día -->
        <service
            android:name=".ScheduleDayWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Actualizar la app desde Ajustes: abrir el instalador con el APK descargado por la propia app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: la notificación del modo estudio como actualización en vivo -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Avisos a la hora exacta (clases y agenda). Desde Android 14 SCHEDULE_EXACT_ALARM viene negado
         y sin él el plugin no programa NINGÚN aviso (solo abre "Alarmas y recordatorios").
         USE_EXACT_ALARM (Android 13+) se concede solo para apps de calendario y recordatorios, como esta;
         SCHEDULE_EXACT_ALARM queda para Android 12 y 12L, donde viene concedido. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Notas de voz en los apuntes: Capacitor pide el permiso del micrófono la primera vez que se graba -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Pasar datos con la PC: la cámara escanea el código QR que muestra la app de Windows
         (Capacitor pide el permiso la primera vez). No se exige cámara para instalar la app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Sala Local por cercanía (Google Nearby Connections: Bluetooth y Wi-Fi Direct, sin red wifi).
         Se piden en tiempo de ejecución solo al usar «Salas cercanas», con una explicación previa.
         - Android 12+: Bluetooth "dispositivos cercanos" (buscar, anunciarse, conectar).
         - Android 13+: Wi-Fi cercano, declarado sin uso de ubicación (neverForLocation).
         - Android 6 a 12L: Bluetooth y wifi exigen permiso de ubicación.
         - Buscar salas (no anunciarlas): Google Nearby exige la ubicación PRECISA en todas las versiones
           (errores 8034/8036 MISSING_PERMISSION_ACCESS_COARSE/FINE_LOCATION, comprobado en Android 17).
           Solo se pide al buscar; anunciar una sala no la necesita. La app no lee la ubicación. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />
</manifest>
