<?xml version="1.0" encoding="utf-8"?>
<!--
  Versión de Google Play: se combina con src/main/AndroidManifest.xml y QUITA el permiso para
  instalar paquetes. En Play la app no se actualiza sola (lo hace la tienda) y Google restringe
  este permiso a apps cuyo propósito principal es instalar otras apps.
  build.gradle comprueba en cada compilación de «play» que el permiso no se cuele de nuevo.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
</manifest>
